model NeutralTimesheet {
  id String @id @default(uuid())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  hearingId String?
  hearing   Hearing? @relation(fields: [hearingId], references: [id], onDelete: SetNull)

  neutralUserId String
  neutral       User   @relation("NeutralTimesheetNeutral", fields: [neutralUserId], references: [id], onDelete: Restrict)

  activityType TimesheetActivityType
  hours        Decimal               @db.Decimal(6, 2)
  entryDate    DateTime
  billingNotes String?               @db.Text

  status           TimesheetStatus         @default(DRAFT)
  approvalStatus   TimesheetApprovalStatus @default(PENDING)
  rejectionComment String?

  approvedByUserId String?
  approvedBy       User?   @relation("NeutralTimesheetApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  rejectedByUserId String?
  rejectedBy       User?   @relation("NeutralTimesheetRejector", fields: [rejectedByUserId], references: [id], onDelete: SetNull)

  submittedAt DateTime?
  reviewedAt  DateTime?

  expenses      TimesheetExpense[]
  reviewHistory TimesheetReviewHistory[]
  lineItems     InvoiceLineItem[]

  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt @db.Timestamp(3)

  @@index([caseId, status])
  @@index([neutralUserId, approvalStatus])
  @@map("neutral_timesheets")
}

model TimesheetExpense {
  id String @id @default(uuid())

  timesheetId String
  timesheet   NeutralTimesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  expenseType TimesheetExpenseType
  expenseDate DateTime
  amount      Decimal              @db.Decimal(12, 2)
  description String?              @db.Text

  receipts TimesheetExpenseReceipt[]

  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt @db.Timestamp(3)

  @@index([timesheetId])
  @@map("timesheet_expenses")
}

model TimesheetExpenseReceipt {
  id String @id @default(uuid())

  expenseId String
  expense   TimesheetExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@unique([expenseId, documentId])
  @@index([documentId])
  @@map("timesheet_expense_receipts")
}

model TimesheetReviewHistory {
  id String @id @default(uuid())

  timesheetId String
  timesheet   NeutralTimesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  action      TimesheetReviewAction
  actorUserId String
  actor       User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  comment     String?

  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@index([timesheetId, createdAt])
  @@index([actorUserId])
  @@map("timesheet_review_history")
}

model BillingConfiguration {
  id String @id @default(uuid())

  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  billingType        BillingType
  billingInputSource BillingInputSource @default(FIRM_INVOICE)
  billingMode        BillingMode        @default(DEPOSIT_BASED)

  // Neutral fee schedule
  neutralHourlyRate           Decimal? @db.Decimal(10, 2)
  neutralDailyRate            Decimal? @db.Decimal(10, 2)
  caseManagementHourlyRate    Decimal? @db.Decimal(10, 2)
  flatFeeAmount               Decimal? @db.Decimal(12, 2)
  includedHearingDays         Int?
  includedPrePostHearingHours Decimal? @db.Decimal(6, 2)
  overageHourlyRate           Decimal? @db.Decimal(10, 2)
  additionalDayRate           Decimal? @db.Decimal(10, 2)
  customRate                  Decimal? @db.Decimal(12, 2)
  customRateDescription       String?
  expensesPolicy              BillingExpensesPolicy?
  travelTimeRateType          TravelTimeRateType     @default(FREE)
  travelTimeCustomHourlyRate  Decimal?               @db.Decimal(10, 2)

  splitBillingEnabled         Boolean   @default(false)
  roundingResidualCasePartyId String?
  roundingResidualCaseParty   CaseParty? @relation("BillingRoundingResidualPayer", fields: [roundingResidualCasePartyId], references: [id], onDelete: SetNull)

  taxApplicability        Boolean @default(false)
  deliveryContactEmail    String?
  billingNotes            String? @db.Text
  accountingAuditComplete Boolean @default(false)

  // FedArb fee schedule
  fedArbFeeScheduleType  CaseType?
  setupFee               Decimal? @db.Decimal(12, 2)
  administrationFee      Decimal? @db.Decimal(12, 2)
  adminFeePercentage     Decimal? @db.Decimal(5, 2)
  agreementFeePercentage Decimal? @db.Decimal(5, 2)
  hasTrustAccount        Boolean  @default(false)

  payerSplits           BillingPayerSplit[]
  additionalTimekeepers BillingAdditionalTimekeeper[]

  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt @db.Timestamp(3)

  @@index([roundingResidualCasePartyId])
  @@map("billing_configurations")
}

model BillingPayerSplit {
  id String @id @default(uuid())

  billingConfigurationId String
  billingConfiguration   BillingConfiguration @relation(fields: [billingConfigurationId], references: [id], onDelete: Cascade)

  casePartyId String
  caseParty   CaseParty @relation(fields: [casePartyId], references: [id], onDelete: Cascade)

  invoiceContactEmail String?
  invoiceContactName  String?
  splitPercentage     Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt @db.Timestamp(3)

  @@unique([billingConfigurationId, casePartyId])
  @@index([casePartyId])
  @@map("billing_payer_splits")
}

model BillingAdditionalTimekeeper {
  id String @id @default(uuid())

  billingConfigurationId String
  billingConfiguration   BillingConfiguration @relation(fields: [billingConfigurationId], references: [id], onDelete: Cascade)

  role            String
  hourlyRate      Decimal               @db.Decimal(10, 2)
  expensesAllowed BillingExpensesPolicy @default(NOT_ALLOWED)

  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt @db.Timestamp(3)

  @@index([billingConfigurationId])
  @@map("billing_additional_timekeepers")
}
